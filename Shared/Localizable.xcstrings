    "Виджет получает трек от приложения, поэтому TrackPin должен работать в фоне.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The widget gets the track from the app, so TrackPin has to keep running in the background."
          }
